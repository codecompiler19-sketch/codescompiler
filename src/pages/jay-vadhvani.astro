---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Mr Jay Vadhvani - Author Profile";
const description = "Author profile for Mr Jay Vadhvani.";
---

<BaseLayout title={title} description={description}>
  <main class="max-w-4xl mx-auto px-5 py-16 min-h-screen">
    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 md:p-12">
      <div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
        <div class="w-32 h-32 md:w-48 md:h-48 rounded-full overflow-hidden bg-gray-100 flex-shrink-0 border-4 border-white shadow-lg">
          <div class="w-full h-full bg-gradient-to-br from-[#04AA6D] to-teal-700 flex items-center justify-center text-white text-5xl font-bold">
            JV
          </div>
        </div>
        <div class="flex-1 text-center md:text-left">
          <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-2">Mr Jay Vadhvani</h1>
          <h2 class="text-lg md:text-xl text-gray-500 font-medium mb-6">Author & Educator</h2>
          
          <div class="prose prose-lg text-gray-600 max-w-none">
            <p>
              Welcome to my author page! I will be providing more information about my background, work, and publications soon.
            </p>
            <p>
              Thank you for reading my books and supporting my work in helping children learn and grow.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
