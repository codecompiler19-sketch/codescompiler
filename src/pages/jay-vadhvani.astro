---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Mr Jay Vadhvani – Author & Educator | CodesCompiler";
const description = "Author and educator profile for Mr Jay Vadhvani. Free books, tutorials, apps, and interactive coding experiments for children and beginners.";
const keywords = "Jay Vadhvani, CodesCompiler, HTML for Kids, CSS for Kids, JavaScript for Kids, Python for Kids, C Programming for Kids, Web Developer, Author, Educator";

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jay Vadhvani",
    "honorificPrefix": "Mr",
    "jobTitle": "Author and Educator",
    "url": "https://codescompiler.com/jay-vadhvani/",
    "worksFor": { "@type": "Organization", "name": "CodesCompiler", "url": "https://codescompiler.com/" },
    "sameAs": [
      "https://www.youtube.com/@CodeCompiler19",
      "https://www.instagram.com/codescompiler/",
      "https://www.facebook.com/CodesCompiler/",
      "https://www.threads.net/@codescompiler",
      "https://www.linkedin.com/in/codescompiler/",
      "https://in.pinterest.com/codecompiler19/"
    ]
  }
];
---

<BaseLayout title={title} description={description} keywords={keywords} schemaData={schemaData}>
  <div class="jv-page bg-[#F2F7FF] dark:bg-[#0A1128] text-[#14213D] dark:text-[#EAF0FF] transition-colors duration-300">
    
    <!-- ==================== HERO SECTION ==================== -->
    <section class="py-12 md:py-20 px-4 sm:px-6 relative overflow-hidden border-b-4 border-[#14213D] dark:border-[#3B4E8C]">
      <!-- Grid pattern background -->
      <div class="absolute inset-0 opacity-40 dark:opacity-20 pointer-events-none" style="background-image: linear-gradient(rgba(36,89,230,.12) 1px, transparent 1px), linear-gradient(90deg, rgba(36,89,230,.12) 1px, transparent 1px); background-size: 34px 34px;"></div>

      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center relative z-10">
        
        <!-- Left Column: Copy & Actions -->
        <div class="lg:col-span-7 flex flex-col items-start">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#14213D] text-[#FFC531] font-bold text-sm mb-6 border-2 border-[#14213D] shadow-[3px_3px_0px_#2459E6]">
            <span>✨</span> Author & Educator at CodesCompiler
          </div>

          <h1 class="font-extrabold text-4xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05] mb-6 text-[#14213D] dark:text-white">
            Hi, I'm <span class="text-[#2459E6] dark:text-[#6C97FF]">Jay Vadhvani</span>.
            <span class="block text-2xl sm:text-3xl md:text-4xl font-bold mt-2 text-[#4A5878] dark:text-[#A9B7DA]">
              Turning code into fun experiments & books for kids.
            </span>
          </h1>

          <p class="text-lg sm:text-xl text-[#4A5878] dark:text-[#A9B7DA] leading-relaxed max-w-2xl mb-8">
            Author and educator at <strong class="text-[#14213D] dark:text-white">CodesCompiler</strong>. I write free books, design tutorials, and build web & mobile apps that make HTML, CSS, JavaScript, and Python feel like experiments anyone can run.
          </p>

          <div class="flex flex-wrap gap-4 items-center mb-8">
            <a href="#books" class="jv-btn primary">
              📚 Read Free Books
            </a>
            <a href="/apps" class="jv-btn">
              📱 Explore Our Apps
            </a>
            <a href="https://codescompiler.com/" target="_blank" rel="noopener" class="jv-btn sun">
              ⚡ Try Live Code Editor
            </a>
          </div>

          <!-- Code Window Snippet -->
          <div class="w-full max-w-lg bg-[#14213D] rounded-2xl border-3 border-[#14213D] shadow-[6px_6px_0px_#2459E6] overflow-hidden text-left font-mono text-sm">
            <div class="bg-[#1D2B4A] px-4 py-2.5 flex items-center gap-2 border-b border-[#2A3C66]">
              <span class="w-3 h-3 rounded-full bg-[#FF6F91] inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-[#FFC531] inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-[#19C39B] inline-block"></span>
              <span class="text-xs text-[#A9B7DA] ml-2">jay-profile.js</span>
            </div>
            <div class="p-4 text-[#EAF0FF] space-y-1">
              <div><span class="text-[#FF6F91]">const</span> <span class="text-[#FFC531]">author</span> = &#123;</div>
              <div class="pl-4"><span class="text-[#6C97FF]">name</span>: <span class="text-[#19C39B]">"Mr Jay Vadhvani"</span>,</div>
              <div class="pl-4"><span class="text-[#6C97FF]">role</span>: <span class="text-[#19C39B]">"Author, Educator & Developer"</span>,</div>
              <div class="pl-4"><span class="text-[#6C97FF]">books</span>: [<span class="text-[#19C39B]">"HTML for Kids"</span>, <span class="text-[#19C39B]">"Python for Kids"</span>, ...],</div>
              <div class="pl-4"><span class="text-[#6C97FF]">status</span>: <span class="text-[#FFC531]">"Building free learning tools"</span></div>
              <div>&#125;;<span class="inline-block w-2 h-4 bg-[#FFC531] ml-1 animate-pulse align-middle"></span></div>
            </div>
          </div>
        </div>

        <!-- Right Column: Orbiting Atom Portrait -->
        <div class="lg:col-span-5 flex flex-col items-center">
          <div class="atom-container relative w-full max-w-[400px] aspect-square mx-auto">
            
            <!-- Orbit Ring 1 -->
            <div class="atom-ring r1 absolute inset-[8%] border-3 border-dashed border-[#7FA0E8] rounded-full animate-[spin_24s_linear_infinite]">
              <div class="chip-holder absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2">
                <span class="atom-chip bg-[#FF7A59] text-white">HTML</span>
              </div>
              <div class="chip-holder absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2">
                <span class="atom-chip bg-[#4C8DFF] text-white">CSS</span>
              </div>
            </div>

            <!-- Orbit Ring 2 -->
            <div class="atom-ring r2 absolute inset-0 border-3 border-dashed border-[#FFC531] rounded-full animate-[spin_36s_linear_infinite_reverse]">
              <div class="chip-holder absolute top-1/2 left-0 -translate-x-1/2 -translate-y-1/2">
                <span class="atom-chip bg-[#FFC531] text-[#14213D]">JS</span>
              </div>
              <div class="chip-holder absolute top-1/2 right-0 translate-x-1/2 -translate-y-1/2">
                <span class="atom-chip bg-[#19C39B] text-white">Python</span>
              </div>
            </div>

            <!-- Central Portrait Core -->
            <div class="portrait-core absolute inset-[20%] rounded-full overflow-hidden border-4 border-[#14213D] bg-gradient-to-br from-[#EAF6FF] via-[#9AD3FF] to-[#7BB8F5] shadow-[0_0_0_8px_rgba(255,197,49,0.45)]">
              <!-- Real Photo Image element -->
              <img id="realPhoto" src="/images/jay-vadhvani.png" alt="Jay Vadhvani" class="w-full h-full object-cover" onload="this.classList.remove('hidden'); document.getElementById('svgAvatar')?.classList.add('hidden');" onerror="this.classList.add('hidden'); document.getElementById('svgAvatar')?.classList.remove('hidden');" />

              <!-- SVG Avatar Fallback -->
              <svg id="svgAvatar" viewBox="0 0 300 300" class="w-full h-full hidden" role="img" aria-label="Avatar of Jay Vadhvani">
                <!-- Lab coat -->
                <path d="M34 300 C34 232 90 206 150 206 C210 206 266 232 266 300 Z" fill="#FFFFFF" stroke="#14213D" stroke-width="5" stroke-linejoin="round"/>
                <path d="M118 210 L150 268 L182 210 Z" fill="#2459E6" stroke="#14213D" stroke-width="5" stroke-linejoin="round"/>
                <path d="M104 212 L150 276 L126 206 Z" fill="#F4F8FF" stroke="#14213D" stroke-width="5" stroke-linejoin="round"/>
                <path d="M196 212 L150 276 L174 206 Z" fill="#F4F8FF" stroke="#14213D" stroke-width="5" stroke-linejoin="round"/>
                <rect x="204" y="248" width="34" height="34" rx="6" fill="#EAF2FF" stroke="#14213D" stroke-width="4"/>
                <rect x="214" y="236" width="5" height="22" rx="2" fill="#FF6F91" stroke="#14213D" stroke-width="2"/>
                <rect x="224" y="240" width="5" height="18" rx="2" fill="#19C39B" stroke="#14213D" stroke-width="2"/>
                <!-- Neck -->
                <path d="M130 170 h40 v34 c-12 12 -28 12 -40 0 z" fill="#B87A4B" stroke="#14213D" stroke-width="5" stroke-linejoin="round"/>
                <!-- Ears -->
                <circle cx="98" cy="140" r="11" fill="#C68B59" stroke="#14213D" stroke-width="5"/>
                <circle cx="202" cy="140" r="11" fill="#C68B59" stroke="#14213D" stroke-width="5"/>
                <!-- Head -->
                <ellipse cx="150" cy="134" rx="52" ry="60" fill="#D39A68" stroke="#14213D" stroke-width="5"/>
                <!-- Hair -->
                <path d="M97 128 C90 66 130 52 152 52 C180 52 212 68 203 128 C196 102 174 92 150 92 C128 92 104 102 97 128 Z" fill="#1B1B2F" stroke="#14213D" stroke-width="5" stroke-linejoin="round"/>
                <!-- Glasses -->
                <rect x="110" y="124" width="34" height="27" rx="10" fill="rgba(255,255,255,.4)" stroke="#14213D" stroke-width="5"/>
                <rect x="156" y="124" width="34" height="27" rx="10" fill="rgba(255,255,255,.4)" stroke="#14213D" stroke-width="5"/>
                <path d="M144 136 H156" stroke="#14213D" stroke-width="5" stroke-linecap="round"/>
                <circle cx="127" cy="138" r="4.5" fill="#14213D"/>
                <circle cx="173" cy="138" r="4.5" fill="#14213D"/>
                <!-- Smile -->
                <path d="M114 116 Q127 108 140 115 M160 115 Q173 108 186 116" fill="none" stroke="#14213D" stroke-width="5" stroke-linecap="round"/>
                <path d="M128 166 Q150 188 172 166" fill="none" stroke="#14213D" stroke-width="5" stroke-linecap="round"/>
              </svg>
            </div>

            <!-- Name Tag Sticker -->
            <div class="absolute -left-2 -bottom-2 bg-white text-[#14213D] border-3 border-[#14213D] rounded-xl px-4 py-2 -rotate-6 shadow-[4px_4px_0px_rgba(20,33,61,0.8)] z-20 font-bold text-center">
              <span class="block text-[11px] uppercase tracking-wider text-[#FF4D6D]">Hello, my name is</span>
              <span class="block text-2xl font-extrabold leading-tight">Jay Vadhvani</span>
            </div>
          </div>

          <!-- Quick Image Preview / Upload Control -->
          <div class="mt-6 text-center">
            <label for="localPhotoUpload" class="jv-btn text-xs !py-1.5 !px-3 cursor-pointer">
              📷 Preview Your Photo
            </label>
            <input type="file" id="localPhotoUpload" accept="image/*" class="hidden" />
            <p class="text-xs text-[#4A5878] dark:text-[#A9B7DA] mt-2">
              Add your image to <code class="bg-gray-200 dark:bg-gray-800 px-1 py-0.5 rounded">public/images/jay-vadhvani.jpg</code>
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- ==================== ABOUT & LAB NOTEBOOK ==================== -->
    <section class="py-16 px-4 sm:px-6" id="about">
      <div class="max-w-6xl mx-auto">
        
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#14213D] dark:text-white tracking-tight mb-3">
            About Mr Jay Vadhvani
          </h2>
          <p class="text-lg text-[#4A5878] dark:text-[#A9B7DA]">
            A developer & educator dedicated to clear layouts, simple explanations, and interactive learning.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
          
          <!-- Lab Notebook Card -->
          <div class="lg:col-span-7 bg-white dark:bg-[#131E42] border-3 border-[#14213D] dark:border-[#3B4E8C] rounded-2xl p-6 sm:p-8 shadow-[8px_8px_0px_#14213D] dark:shadow-[8px_8px_0px_#3B4E8C] relative">
            <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-[#FF6F91] opacity-70"></div>
            
            <div class="pl-6 space-y-4">
              <h3 class="text-2xl font-extrabold text-[#14213D] dark:text-white border-b-2 border-gray-100 dark:border-gray-800 pb-3">
                📋 Lab Notebook & Credentials
              </h3>

              <dl class="grid grid-cols-1 sm:grid-cols-3 gap-y-3 gap-x-4 text-base">
                <dt class="font-bold text-[#14213D] dark:text-[#6C97FF]">Name:</dt>
                <dd class="sm:col-span-2 font-semibold">Mr Jay Vadhvani</dd>

                <dt class="font-bold text-[#14213D] dark:text-[#6C97FF]">Role:</dt>
                <dd class="sm:col-span-2">Author, Educator & Web Developer</dd>

                <dt class="font-bold text-[#14213D] dark:text-[#6C97FF]">Platform:</dt>
                <dd class="sm:col-span-2">CodesCompiler (Tutorials, Live Editor & Apps)</dd>

                <dt class="font-bold text-[#14213D] dark:text-[#6C97FF]">Teaches:</dt>
                <dd class="sm:col-span-2">HTML, CSS, JavaScript, Python, SQL, PHP, C & SEO</dd>

                <dt class="font-bold text-[#14213D] dark:text-[#6C97FF]">Books Written:</dt>
                <dd class="sm:col-span-2">Free coding books tailored for kids & beginners</dd>

                <dt class="font-bold text-[#14213D] dark:text-[#6C97FF]">Mission:</dt>
                <dd class="sm:col-span-2">To make programming accessible, engaging, and free for young minds worldwide.</dd>
              </dl>
            </div>
          </div>

          <!-- Desk Illustration / Teaching Philosophy -->
          <div class="lg:col-span-5 bg-[#CFE4FF] dark:bg-[#1C2A54] border-3 border-[#14213D] dark:border-[#3B4E8C] rounded-2xl p-6 sm:p-8 flex flex-col justify-between shadow-[8px_8px_0px_#14213D]">
            <div>
              <span class="inline-block px-3 py-1 bg-[#2459E6] text-white font-bold text-xs rounded-full mb-4">
                TEACHING PHILOSOPHY
              </span>
              <h3 class="text-2xl font-extrabold text-[#14213D] dark:text-white mb-4">
                The 4-Step Science Approach
              </h3>
              <ol class="space-y-3 font-medium text-[#14213D] dark:text-[#EAF0FF]">
                <li class="flex items-start gap-3">
                  <span class="w-7 h-7 rounded-full bg-[#FFC531] text-[#14213D] font-bold flex items-center justify-center text-sm flex-shrink-0 border-2 border-[#14213D]">1</span>
                  <div><strong>Wonder:</strong> Start with questions kids ask naturally.</div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-7 h-7 rounded-full bg-[#19C39B] text-white font-bold flex items-center justify-center text-sm flex-shrink-0 border-2 border-[#14213D]">2</span>
                  <div><strong>Experiment:</strong> Run code live in the browser editor.</div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-7 h-7 rounded-full bg-[#4C8DFF] text-white font-bold flex items-center justify-center text-sm flex-shrink-0 border-2 border-[#14213D]">3</span>
                  <div><strong>Build:</strong> Turn experiments into real web apps.</div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-7 h-7 rounded-full bg-[#FF6F91] text-white font-bold flex items-center justify-center text-sm flex-shrink-0 border-2 border-[#14213D]">4</span>
                  <div><strong>Share:</strong> Keep books & tutorials 100% free.</div>
                </li>
              </ol>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ==================== PERIODIC TABLE OF CODE ==================== -->
    <section class="py-16 px-4 sm:px-6 bg-white dark:bg-[#0E1736] border-y-4 border-[#14213D] dark:border-[#3B4E8C]" id="elements">
      <div class="max-w-6xl mx-auto">
        
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#14213D] dark:text-white tracking-tight mb-3">
            🏷️ The Periodic Table of Code
          </h2>
          <p class="text-lg text-[#4A5878] dark:text-[#A9B7DA]">
            Explore key programming languages and technologies taught across CodesCompiler tutorials and books.
          </p>
        </div>

        <!-- Full-width Element Cards Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
          
          <article class="jv-card p-5 flex flex-col justify-between h-full bg-[#FF7A59]/10 border-[#FF7A59]" style="--c:#FF7A59">
            <div>
              <span class="text-xs font-mono font-bold text-gray-500">01</span>
              <div class="text-4xl font-black my-2 text-[#FF7A59]">Ht</div>
              <h3 class="font-extrabold text-xl mb-1 text-[#14213D] dark:text-white">HTML</h3>
              <p class="text-xs text-gray-600 dark:text-gray-300">The essential structure & layout of every web page.</p>
            </div>
            <a href="/tutorial/html-introduction" class="jv-btn text-xs mt-6 text-center">Open Tutorial →</a>
          </article>

          <article class="jv-card p-5 flex flex-col justify-between h-full bg-[#4C8DFF]/10 border-[#4C8DFF]" style="--c:#4C8DFF">
            <div>
              <span class="text-xs font-mono font-bold text-gray-500">02</span>
              <div class="text-4xl font-black my-2 text-[#4C8DFF]">Cs</div>
              <h3 class="font-extrabold text-xl mb-1 text-[#14213D] dark:text-white">CSS</h3>
              <p class="text-xs text-gray-600 dark:text-gray-300">Styles, colors, animations & responsive grid layouts.</p>
            </div>
            <a href="/tutorial/css-introduction" class="jv-btn text-xs mt-6 text-center">Open Tutorial →</a>
          </article>

          <article class="jv-card p-5 flex flex-col justify-between h-full bg-[#FFC531]/10 border-[#FFC531]" style="--c:#FFC531">
            <div>
              <span class="text-xs font-mono font-bold text-gray-500">03</span>
              <div class="text-4xl font-black my-2 text-[#E5AC00] dark:text-[#FFC531]">Js</div>
              <h3 class="font-extrabold text-xl mb-1 text-[#14213D] dark:text-white">JavaScript</h3>
              <p class="text-xs text-gray-600 dark:text-gray-300">Interactivity, dynamic applications & game logic.</p>
            </div>
            <a href="/tutorial/javascript-introduction" class="jv-btn text-xs mt-6 text-center">Open Tutorial →</a>
          </article>

          <article class="jv-card p-5 flex flex-col justify-between h-full bg-[#38C79A]/10 border-[#38C79A]" style="--c:#38C79A">
            <div>
              <span class="text-xs font-mono font-bold text-gray-500">04</span>
              <div class="text-4xl font-black my-2 text-[#38C79A]">Py</div>
              <h3 class="font-extrabold text-xl mb-1 text-[#14213D] dark:text-white">Python</h3>
              <p class="text-xs text-gray-600 dark:text-gray-300">Clean syntax for scripts, automation & AI basics.</p>
            </div>
            <a href="/tutorial/python-introduction" class="jv-btn text-xs mt-6 text-center">Open Tutorial →</a>
          </article>

          <article class="jv-card p-5 flex flex-col justify-between h-full bg-[#9B7BFF]/10 border-[#9B7BFF]" style="--c:#9B7BFF">
            <div>
              <span class="text-xs font-mono font-bold text-gray-500">05</span>
              <div class="text-4xl font-black my-2 text-[#9B7BFF]">Sq</div>
              <h3 class="font-extrabold text-xl mb-1 text-[#14213D] dark:text-white">SQL</h3>
              <p class="text-xs text-gray-600 dark:text-gray-300">Storing, organizing & querying relational databases.</p>
            </div>
            <a href="/tutorial/sql-introduction" class="jv-btn text-xs mt-6 text-center">Open Tutorial →</a>
          </article>

          <article class="jv-card p-5 flex flex-col justify-between h-full bg-[#8E9BFF]/10 border-[#8E9BFF]" style="--c:#8E9BFF">
            <div>
              <span class="text-xs font-mono font-bold text-gray-500">06</span>
              <div class="text-4xl font-black my-2 text-[#8E9BFF]">Ph</div>
              <h3 class="font-extrabold text-xl mb-1 text-[#14213D] dark:text-white">PHP</h3>
              <p class="text-xs text-gray-600 dark:text-gray-300">Server-side programming powering web platforms.</p>
            </div>
            <a href="/tutorial/php-introduction" class="jv-btn text-xs mt-6 text-center">Open Tutorial →</a>
          </article>

          <article class="jv-card p-5 flex flex-col justify-between h-full bg-[#FF7BA5]/10 border-[#FF7BA5]" style="--c:#FF7BA5">
            <div>
              <span class="text-xs font-mono font-bold text-gray-500">07</span>
              <div class="text-4xl font-black my-2 text-[#FF7BA5]">Se</div>
              <h3 class="font-extrabold text-xl mb-1 text-[#14213D] dark:text-white">SEO</h3>
              <p class="text-xs text-gray-600 dark:text-gray-300">Optimizing web pages so people can find your content.</p>
            </div>
            <a href="/tutorial/seo-introduction" class="jv-btn text-xs mt-6 text-center">Open Tutorial →</a>
          </article>

          <article class="jv-card p-5 flex flex-col justify-between h-full bg-[#8FA3BF]/10 border-[#8FA3BF]" style="--c:#8FA3BF">
            <div>
              <span class="text-xs font-mono font-bold text-gray-500">08</span>
              <div class="text-4xl font-black my-2 text-[#8FA3BF]">C</div>
              <h3 class="font-extrabold text-xl mb-1 text-[#14213D] dark:text-white">C Language</h3>
              <p class="text-xs text-gray-600 dark:text-gray-300">Understanding computer hardware & low-level memory.</p>
            </div>
            <a href="/books/c-programming-for-kids" class="jv-btn text-xs mt-6 text-center">Open Book →</a>
          </article>

        </div>

      </div>
    </section>

    <!-- ==================== FREE BOOK SHELF ==================== -->
    <section class="py-16 px-4 sm:px-6" id="books">
      <div class="max-w-6xl mx-auto">
        
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 gap-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-[#2459E6] dark:text-[#6C97FF]">AUTHOR PUBLICATIONS</span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-[#14213D] dark:text-white tracking-tight mt-1">
              📚 Free Coding Books for Kids
            </h2>
          </div>
          <a href="/books" class="jv-btn primary text-sm">
            View All Books Collection →
          </a>
        </div>

        <!-- 3D Bookshelf Row -->
        <div class="bg-gradient-to-b from-transparent to-amber-900/10 border-b-16 border-[#B9793E] rounded-t-lg p-6 flex gap-6 overflow-x-auto scrollbar-none items-end pb-2">
          
          <!-- Book 1: HTML for Kids -->
          <button type="button" class="book-card group flex-none w-36 sm:w-44 bg-[#FF8A65] border-3 border-[#14213D] rounded-l-md rounded-r-xl p-4 flex flex-col justify-between text-left cursor-pointer transition-all duration-200 hover:-translate-y-4 hover:rotate-[-2deg] shadow-[4px_4px_0px_#14213D] text-[#14213D]"
            data-title="HTML for Kids"
