  <!-- Client JavaScript for Photo Loader & Book Shelf -->
  <script is:inline>
    // --- Local Photo Preview Logic ---
    (function initPhoto() {
      const uploadInput = document.getElementById('localPhotoUpload');
      const realPhoto = document.getElementById('realPhoto');
      const svgAvatar = document.getElementById('svgAvatar');

      if (realPhoto && svgAvatar) {
        if (realPhoto.complete && realPhoto.naturalHeight !== 0) {
          realPhoto.classList.remove('hidden');
          svgAvatar.classList.add('hidden');
        }
      }

      if (uploadInput) {
        uploadInput.addEventListener('change', (e) => {
          const file = e.target.files && e.target.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = function(evt) {
              if (realPhoto) {
                realPhoto.src = evt.target.result;
                realPhoto.classList.remove('hidden');
                if (svgAvatar) svgAvatar.classList.add('hidden');
              }
            };
            reader.readAsDataURL(file);
          }
        });
      }
    })();

    // --- Book Shelf Preview Selector ---
    (function initBooks() {
      const cards = document.querySelectorAll('.book-card');
      const previewTitle = document.getElementById('previewTitle');
      const previewDesc = document.getElementById('previewDesc');
      const previewBtn = document.getElementById('previewBtn');

      cards.forEach(card => {
        card.addEventListener('click', () => {
          const title = card.dataset.title;
          const desc = card.dataset.desc;
          const link = card.dataset.link;

          if (previewTitle) previewTitle.textContent = title;
          if (previewDesc) previewDesc.textContent = desc;
          if (previewBtn) {
            previewBtn.href = link;
            previewBtn.textContent = `Read ${title} Free →`;
          }
        });
      });
    })();
  </script>
