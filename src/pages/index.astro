---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLayout1 from '../components/home/HomeLayout1.astro';
import HomeLayout2 from '../components/home/HomeLayout2.astro';
import HomeLayout3 from '../components/home/HomeLayout3.astro';
import HomeLayout4 from '../components/home/HomeLayout4.astro';
import HomeLayout5 from '../components/home/HomeLayout5.astro';
import HomeLayout6 from '../components/home/HomeLayout6.astro';
import HomeLayout7 from '../components/home/HomeLayout7.astro';
import HomeLayout8 from '../components/home/HomeLayout8.astro';
import { getCollection } from 'astro:content';
import themeRaw from '../theme-settings.json';

const theme = themeRaw || {};
const layout = theme.homepageLayout || 'layout1';

const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const CATEGORY_COLORS: Record<string, { color: string; bg: string }> = {
  'HTML & CSS':           { color: '#E34F26', bg: '#fff4f0' },
  'JavaScript':           { color: '#ca8a04', bg: '#fefce8' },
  'HTML CSS JavaScript':  { color: '#04AA6D', bg: '#f0fff8' },
};

const siteUrl = "https://codescompiler.com";

// JSON-LD schemas
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "CodesCompiler",
  "url": `${siteUrl}/`,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/?s={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};

const coursesSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "HTML Tutorial for Beginners",
    "description": "Learn HTML from scratch. Structure web pages, create lists, tables, forms, and understand semantic HTML tags with a live browser-based code editor.",
    "provider": {
      "@type": "Organization",
      "name": "CodesCompiler",
      "sameAs": siteUrl
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "CSS Tutorial: Styling Web Pages",
    "description": "Learn CSS to style web pages. Master selectors, color properties, fonts, Flexbox, Grid, layouts, and animations.",
    "provider": {
      "@type": "Organization",
      "name": "CodesCompiler",
      "sameAs": siteUrl
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "JavaScript Interactive Tutorial",
    "description": "Learn JavaScript programming. Master variables, functions, loops, event handling, DOM manipulation, APIs, and building interactive web projects.",
    "provider": {
      "@type": "Organization",
      "name": "CodesCompiler",
      "sameAs": siteUrl
    }
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is CodesCompiler?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CodesCompiler is a free interactive web development learning platform where you can learn HTML, CSS, and JavaScript directly in your browser without any setup."
      }
    },
    {
      "@type": "Question",
      "name": "Is CodesCompiler really free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, CodesCompiler is completely free. There are no sign-ups, no subscription fees, and all coding environments are free to use."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to install any software to learn?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No software installation is required. CodesCompiler provides an in-browser code editor and live preview so you can write and run code instantly."
      }
    }
  ]
};

const schemaData = [websiteSchema, ...coursesSchema, faqSchema];
---

<BaseLayout 
  title="Learn HTML, CSS & JavaScript Free" 
  description="Learn HTML, CSS and JavaScript free with interactive tutorials and a live code editor. Beginner-friendly, no sign-up. Start coding in your browser today."
  schemaData={schemaData}
>

{layout === 'layout1' && <HomeLayout1 />}
{layout === 'layout2' && <HomeLayout2 />}
{layout === 'layout3' && <HomeLayout3 />}
{layout === 'layout4' && <HomeLayout4 />}
{layout === 'layout5' && <HomeLayout5 />}
{layout === 'layout6' && <HomeLayout6 />}
{layout === 'layout7' && <HomeLayout7 />}
{layout === 'layout8' && <HomeLayout8 />}

</BaseLayout>
