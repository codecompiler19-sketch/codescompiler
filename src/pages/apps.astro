---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Our Apps – Android Apps by CodesCompiler";
const description = "Explore Android applications created by CodesCompiler for devotion, meditation, wellness, and fitness.";
const keywords = "CodesCompiler Apps, Naam Jap, Shri Hanuman Chalisa, Women Fitness Pro, Hanuman Bhakti, Android Apps, Devotional Apps";

// App Icon paths (Local high-res Play Store icons)
const appIcons = {
  naamJap: "/images/apps/naam-jap.png",
  hanumanChalisa: "/images/apps/hanuman-chalisa.png",
  womenFitness: "/images/apps/women-fitness-pro.png",
  hanumanBhakti: "/images/apps/hanuman-bhakti.png",
};
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <div class="apps-redesign-page bg-gray-50 dark:bg-[#0A1128] text-[#102033] dark:text-[#EAF0FF] transition-colors duration-300">
    
    <!-- ==================== HERO SECTION ==================== -->
    <section class="relative overflow-hidden py-16 lg:py-24 bg-white dark:bg-[#0E1736] border-b border-gray-200 dark:border-gray-800">
      <div class="absolute inset-0 opacity-40 dark:opacity-20 pointer-events-none" style="background: radial-gradient(circle at 85% 20%, rgba(8,127,91,.15), transparent 30%), radial-gradient(circle at 10% 80%, rgba(96,165,250,.15), transparent 30%);"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center relative z-10">
        
        <!-- Hero Text -->
        <div class="lg:col-span-7 flex flex-col items-start">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 font-bold text-xs uppercase tracking-wider mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Built by CodesCompiler
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.05] text-[#102033] dark:text-white mb-6">
            Useful apps.<br />
            <span class="text-emerald-600 dark:text-emerald-400">Made with purpose.</span>
          </h1>

          <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl mb-8">
            Explore our collection of Android applications created to support devotion, meditation, wellness, and everyday routines — with simple, focused experiences.
          </p>

          <div class="flex flex-wrap gap-4 items-center">
            <a href="#apps" class="px-6 py-3.5 rounded-xl font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-lg shadow-emerald-600/20 transition-all hover:-translate-y-0.5">
              Explore Apps ↓
            </a>
            <a href="/" class="px-6 py-3.5 rounded-xl font-bold bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-all">
              Visit CodesCompiler Home
            </a>
          </div>
        </div>

        <!-- Hero Graphic Mockup -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="w-full max-w-[340px] aspect-[4/5] rounded-3xl bg-gradient-to-br from-[#102033] to-[#173c35] p-6 relative overflow-hidden shadow-2xl flex items-center justify-center">
            <div class="absolute -right-16 -top-16 w-56 h-56 rounded-full bg-emerald-500/30 blur-2xl"></div>
            <div class="absolute -left-16 -bottom-16 w-48 h-48 rounded-full bg-indigo-500/20 blur-2xl"></div>

            <div class="w-[200px] h-[340px] border-8 border-gray-900 rounded-[30px] bg-white dark:bg-gray-900 p-3 shadow-2xl rotate-3 relative z-10">
              <div class="h-full rounded-2xl bg-gradient-to-b from-emerald-50 to-teal-50 dark:from-gray-800 dark:to-gray-900 p-4 text-center flex flex-col justify-between">
                <div class="w-16 h-2 rounded-full bg-emerald-200 dark:bg-gray-700 mx-auto"></div>
                <div>
                  <h3 class="font-extrabold text-xl text-gray-800 dark:text-white">Daily Focus</h3>
                  <div class="w-full h-2 rounded bg-emerald-200 dark:bg-gray-700 my-2"></div>
                  <div class="w-2/3 h-2 rounded bg-emerald-200 dark:bg-gray-700 mx-auto mb-4"></div>
                  <div class="w-20 h-20 rounded-full border-4 border-emerald-600 flex items-center justify-center font-extrabold text-2xl text-emerald-700 dark:text-emerald-400 mx-auto">
                    108
                  </div>
                </div>
                <div class="space-y-1">
                  <div class="w-full h-2 rounded bg-emerald-200 dark:bg-gray-700"></div>
                  <div class="w-1/2 h-2 rounded bg-emerald-200 dark:bg-gray-700 mx-auto"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ==================== FEATURED APP SECTION ==================== -->
    <section class="py-16 lg:py-20 bg-white dark:bg-[#0A1128] border-b border-gray-200 dark:border-gray-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-extrabold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">FEATURED APP</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#102033] dark:text-white tracking-tight">
            Make every chant count.
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
            Naam Jap brings traditional mantra chanting into a simple digital experience. Set a daily goal, count repetitions, and keep your spiritual practice consistent.
          </p>

          <div class="border-t border-b border-gray-200 dark:border-gray-800 divide-y divide-gray-200 dark:divide-gray-800 my-6">
            <div class="py-3.5 flex items-center gap-4">
              <span class="font-extrabold text-emerald-600 dark:text-emerald-400 text-sm">01</span>
              <span class="font-bold text-gray-800 dark:text-gray-200 text-base">Daily chanting goals</span>
            </div>
            <div class="py-3.5 flex items-center gap-4">
              <span class="font-extrabold text-emerald-600 dark:text-emerald-400 text-sm">02</span>
              <span class="font-bold text-gray-800 dark:text-gray-200 text-base">Progress & repetition tracking</span>
            </div>
            <div class="py-3.5 flex items-center gap-4">
              <span class="font-extrabold text-emerald-600 dark:text-emerald-400 text-sm">03</span>
              <span class="font-bold text-gray-800 dark:text-gray-200 text-base">Audio and haptic feedback support</span>
            </div>
          </div>

          <a href="https://play.google.com/store/apps/details?id=com.namjapp.app" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-lg shadow-emerald-600/20 transition-all">
            Get Naam Jap on Play Store →
          </a>
        </div>

        <div class="lg:col-span-6 flex justify-center">
          <div class="w-full max-w-[360px] h-[400px] rounded-3xl bg-gradient-to-br from-[#102033] to-[#124f42] p-6 relative overflow-hidden shadow-2xl flex items-center justify-center">
            <div class="w-64 h-64 rounded-full bg-emerald-500/20 blur-3xl absolute"></div>
            
            <div class="w-[220px] h-[370px] border-8 border-gray-900 rounded-[32px] bg-white dark:bg-gray-900 p-4 shadow-2xl rotate-2 relative z-10">
              <div class="h-full rounded-2xl bg-gradient-to-b from-emerald-50 to-teal-50 dark:from-gray-800 dark:to-gray-900 p-4 flex flex-col justify-between">
                <div>
                  <span class="text-xs font-bold text-gray-500">Today's practice</span>
                  <b class="block text-5xl font-black text-emerald-700 dark:text-emerald-400 mt-2">108</b>
                  <span class="text-xs text-gray-500">repetitions completed</span>
                  <div class="h-2 rounded-full bg-gray-200 dark:bg-gray-700 mt-4 overflow-hidden">
                    <div class="h-full bg-emerald-600 w-full rounded-full"></div>
                  </div>
                </div>
                <div class="space-y-2 text-xs border-t border-gray-200 dark:border-gray-800 pt-3">
                  <div class="flex justify-between">
                    <span class="text-gray-500">Daily goal</span>
                    <strong class="font-bold text-gray-900 dark:text-white">108 / 108</strong>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-500">Current streak</span>
                    <strong class="font-bold text-gray-900 dark:text-white">7 days</strong>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- ==================== APPS GRID SECTION ==================== -->
    <section class="py-16 lg:py-24 px-4 sm:px-6" id="apps">
      <div class="max-w-6xl mx-auto">
        
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="text-xs font-extrabold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">APP COLLECTION</span>
          <h2 class="text-3xl sm:text-5xl font-extrabold text-[#102033] dark:text-white tracking-tight mt-2 mb-4">
            Apps designed to fit into real life
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-300">
            Each app has a clear purpose, a focused interface, and a lightweight experience without unnecessary clutter.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <!-- App 1: Naam Jap -->
          <article class="bg-white dark:bg-[#131E42] border border-gray-200 dark:border-gray-800 rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 flex flex-col">
            <div class="h-56 bg-gradient-to-br from-emerald-100 to-teal-100 dark:from-emerald-950/40 dark:to-teal-900/40 p-6 flex items-center justify-center relative overflow-hidden">
              <div class="w-32 h-32 rounded-3xl overflow-hidden shadow-2xl border-4 border-white dark:border-gray-800 relative z-10 bg-white flex items-center justify-center">
                <img 
                  src={appIcons.naamJap} 
                  alt="Naam Jap Play Store Icon" 
                  class="w-full h-full object-cover rounded-2xl" 
                />
              </div>
            </div>
            <div class="p-8 flex flex-col flex-grow justify-between space-y-6">
              <div>
                <span class="text-xs font-extrabold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Devotion & Meditation</span>
                <h3 class="text-2xl font-extrabold text-[#102033] dark:text-white mt-1 mb-3">Naam Jap</h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-sm">
                  A digital chanting counter for daily mantra recitation, with progress tracking, audio assistance, and haptic feedback.
                </p>
              </div>

              <div class="flex items-center justify-between gap-4 pt-4 border-t border-gray-100 dark:border-gray-800">
                <a href="https://play.google.com/store/apps/details?id=com.namjapp.app" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 bg-gray-900 hover:bg-black text-white px-5 py-3 rounded-xl font-bold text-sm shadow-md transition-all">
                  <svg class="w-5 h-5 fill-current text-emerald-400" viewBox="0 0 512 512">
                    <path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58 33.3-60.7-60.7 118.7 27.4c15.9 3.7 21.8 14.1 21.8 22.2 0 8.1-5.9 18.5-21.8 22.2zM325.3 277.7L385.4 338 104.6 499l220.7-221.3z"/>
                  </svg>
                  Google Play
                </a>
                <a href="https://play.google.com/store/apps/details?id=com.namjapp.app" target="_blank" rel="noopener noreferrer" class="text-emerald-600 dark:text-emerald-400 font-bold text-sm hover:underline">
                  View details →
                </a>
              </div>
            </div>
          </article>

          <!-- App 2: Shri Hanuman Chalisa -->
          <article class="bg-white dark:bg-[#131E42] border border-gray-200 dark:border-gray-800 rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 flex flex-col">
            <div class="h-56 bg-gradient-to-br from-amber-100 to-orange-100 dark:from-amber-950/40 dark:to-orange-900/40 p-6 flex items-center justify-center relative overflow-hidden">
              <div class="w-32 h-32 rounded-3xl overflow-hidden shadow-2xl border-4 border-white dark:border-gray-800 relative z-10 bg-white flex items-center justify-center">
                <img 
                  src={appIcons.hanumanChalisa} 
                  alt="Shri Hanuman Chalisa Play Store Icon" 
                  class="w-full h-full object-cover rounded-2xl" 
                />
              </div>
            </div>
            <div class="p-8 flex flex-col flex-grow justify-between space-y-6">
              <div>
                <span class="text-xs font-extrabold uppercase tracking-wider text-orange-600 dark:text-orange-400">Devotional Lyrics & Audio</span>
                <h3 class="text-2xl font-extrabold text-[#102033] dark:text-white mt-1 mb-3">Shri Hanuman Chalisa</h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-sm">
                  Read and listen to the Hanuman Chalisa with multiple languages, clean reading views, high-quality audio, and offline access.
                </p>
              </div>

              <div class="flex items-center justify-between gap-4 pt-4 border-t border-gray-100 dark:border-gray-800">
                <a href="https://play.google.com/store/apps/details?id=com.shrihanumanchalisa.app" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 bg-gray-900 hover:bg-black text-white px-5 py-3 rounded-xl font-bold text-sm shadow-md transition-all">
                  <svg class="w-5 h-5 fill-current text-orange-400" viewBox="0 0 512 512">
                    <path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58 33.3-60.7-60.7 118.7 27.4c15.9 3.7 21.8 14.1 21.8 22.2 0 8.1-5.9 18.5-21.8 22.2zM325.3 277.7L385.4 338 104.6 499l220.7-221.3z"/>
                  </svg>
                  Google Play
                </a>
                <a href="https://play.google.com/store/apps/details?id=com.shrihanumanchalisa.app" target="_blank" rel="noopener noreferrer" class="text-orange-600 dark:text-orange-400 font-bold text-sm hover:underline">
                  View details →
                </a>
              </div>
            </div>
          </article>

          <!-- App 3: Women Fitness Pro -->
          <article class="bg-white dark:bg-[#131E42] border border-gray-200 dark:border-gray-800 rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 flex flex-col">
            <div class="h-56 bg-gradient-to-br from-blue-100 to-indigo-100 dark:from-blue-950/40 dark:to-indigo-900/40 p-6 flex items-center justify-center relative overflow-hidden">
              <div class="w-32 h-32 rounded-3xl overflow-hidden shadow-2xl border-4 border-white dark:border-gray-800 relative z-10 bg-white flex items-center justify-center">
                <img 
                  src={appIcons.womenFitness} 
                  alt="Women Fitness Pro Play Store Icon" 
                  class="w-full h-full object-cover rounded-2xl" 
                />
              </div>
            </div>
            <div class="p-8 flex flex-col flex-grow justify-between space-y-6">
              <div>
                <span class="text-xs font-extrabold uppercase tracking-wider text-blue-600 dark:text-blue-400">Health & Workout</span>
                <h3 class="text-2xl font-extrabold text-[#102033] dark:text-white mt-1 mb-3">Women Fitness Pro</h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-sm">
                  Workout routines, diet planning, water reminders, and daily habit tracking designed for practical at-home fitness.
                </p>
              </div>

              <div class="flex items-center justify-between gap-4 pt-4 border-t border-gray-100 dark:border-gray-800">
                <a href="https://play.google.com/store/apps/details?id=com.womenfitness.women_fitness_pro" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 bg-gray-900 hover:bg-black text-white px-5 py-3 rounded-xl font-bold text-sm shadow-md transition-all">
                  <svg class="w-5 h-5 fill-current text-blue-400" viewBox="0 0 512 512">
                    <path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58 33.3-60.7-60.7 118.7 27.4c15.9 3.7 21.8 14.1 21.8 22.2 0 8.1-5.9 18.5-21.8 22.2zM325.3 277.7L385.4 338 104.6 499l220.7-221.3z"/>
                  </svg>
                  Google Play
                </a>
                <a href="https://play.google.com/store/apps/details?id=com.womenfitness.women_fitness_pro" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 font-bold text-sm hover:underline">
                  View details →
                </a>
              </div>
            </div>
          </article>

          <!-- App 4: Hanuman Bhakti -->
          <article class="bg-white dark:bg-[#131E42] border border-gray-200 dark:border-gray-800 rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 flex flex-col">
            <div class="h-56 bg-gradient-to-br from-pink-100 to-rose-100 dark:from-pink-950/40 dark:to-rose-900/40 p-6 flex items-center justify-center relative overflow-hidden">
              <div class="w-32 h-32 rounded-3xl overflow-hidden shadow-2xl border-4 border-white dark:border-gray-800 relative z-10 bg-white flex items-center justify-center">
                <img 
                  src={appIcons.hanumanBhakti} 
                  alt="Hanuman Bhakti Play Store Icon" 
                  class="w-full h-full object-cover rounded-2xl" 
                />
              </div>
            </div>
            <div class="p-8 flex flex-col flex-grow justify-between space-y-6">
              <div>
                <span class="text-xs font-extrabold uppercase tracking-wider text-rose-600 dark:text-rose-400">Devotion & Bhajans</span>
                <h3 class="text-2xl font-extrabold text-[#102033] dark:text-white mt-1 mb-3">Hanuman Bhakti</h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-sm">
                  A devotional collection of bhajans, wallpapers, quotes, and spiritual stories for daily Hanuman devotion.
                </p>
              </div>

              <div class="flex items-center justify-between gap-4 pt-4 border-t border-gray-100 dark:border-gray-800">
                <a href="https://play.google.com/store/apps/details?id=com.devotional.hanuman_bhakti.hanuman_bhakti" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 bg-gray-900 hover:bg-black text-white px-5 py-3 rounded-xl font-bold text-sm shadow-md transition-all">
                  <svg class="w-5 h-5 fill-current text-rose-400" viewBox="0 0 512 512">
                    <path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58 33.3-60.7-60.7 118.7 27.4c15.9 3.7 21.8 14.1 21.8 22.2 0 8.1-5.9 18.5-21.8 22.2zM325.3 277.7L385.4 338 104.6 499l220.7-221.3z"/>
                  </svg>
                  Google Play
                </a>
                <a href="https://play.google.com/store/apps/details?id=com.devotional.hanuman_bhakti.hanuman_bhakti" target="_blank" rel="noopener noreferrer" class="text-rose-600 dark:text-rose-400 font-bold text-sm hover:underline">
                  View details →
                </a>
              </div>
            </div>
          </article>

        </div>

        <!-- Why these apps -->
        <div class="mt-24 pt-12 border-t border-gray-200 dark:border-gray-800">
          <div class="text-center max-w-xl mx-auto mb-12">
            <span class="text-xs font-extrabold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">WHY THESE APPS</span>
            <h2 class="text-3xl font-extrabold text-[#102033] dark:text-white mt-1">
              Built around usefulness, not clutter
            </h2>
            <p class="text-sm text-gray-600 dark:text-gray-300 mt-2">
              Every product starts with a simple problem and is designed around a focused everyday experience.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white dark:bg-[#131E42] border border-gray-200 dark:border-gray-800 rounded-2xl p-6 shadow-sm">
              <span class="font-black text-emerald-600 dark:text-emerald-400 text-xs tracking-wider">01</span>
              <h3 class="font-bold text-lg text-gray-900 dark:text-white my-2">Focused experience</h3>
              <p class="text-xs text-gray-600 dark:text-gray-300">Clear screens and straightforward actions keep the important things easy to find.</p>
            </div>
            <div class="bg-white dark:bg-[#131E42] border border-gray-200 dark:border-gray-800 rounded-2xl p-6 shadow-sm">
              <span class="font-black text-emerald-600 dark:text-emerald-400 text-xs tracking-wider">02</span>
              <h3 class="font-bold text-lg text-gray-900 dark:text-white my-2">Made for daily use</h3>
              <p class="text-xs text-gray-600 dark:text-gray-300">Features are designed for routines you can return to every day.</p>
            </div>
            <div class="bg-white dark:bg-[#131E42] border border-gray-200 dark:border-gray-800 rounded-2xl p-6 shadow-sm">
              <span class="font-black text-emerald-600 dark:text-emerald-400 text-xs tracking-wider">03</span>
              <h3 class="font-bold text-lg text-gray-900 dark:text-white my-2">Privacy-conscious</h3>
              <p class="text-xs text-gray-600 dark:text-gray-300">Apps are designed to request only the permissions and services they actually need.</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ==================== STATS STRIP ==================== -->
    <section class="py-12 px-4 sm:px-6 bg-[#102033] text-white">
      <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 divide-y md:divide-y-0 md:divide-x divide-gray-800 text-center">
        <div class="py-4">
          <strong class="block text-3xl font-black text-emerald-400">4</strong>
          <span class="text-sm text-gray-300">Focused Android apps</span>
        </div>
        <div class="py-4">
          <strong class="block text-3xl font-black text-emerald-400">Simple</strong>
          <span class="text-sm text-gray-300">Clean, distraction-free experiences</span>
        </div>
        <div class="py-4">
          <strong class="block text-3xl font-black text-emerald-400">CodesCompiler</strong>
          <span class="text-sm text-gray-300">Designed and maintained in-house</span>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
