---
import { getCollection } from 'astro:content';
import themeRaw from '../../theme-settings.json';

const theme = themeRaw || {};
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const CATEGORY_COLORS: Record<string, { color: string; bg: string }> = {
  'HTML & CSS':           { color: '#E34F26', bg: '#fff4f0' },
  'JavaScript':           { color: '#ca8a04', bg: '#fefce8' },
  'HTML CSS JavaScript':  { color: '#04AA6D', bg: '#f0fff8' },
};
---

<section class="w-full bg-slate-50 border-b border-gray-200 overflow-hidden">
  <div class="max-w-7xl mx-auto px-5 py-16 sm:py-24 lg:py-32 flex flex-col lg:flex-row items-center gap-12 lg:gap-8">
    <div class="flex-1 text-center lg:text-left z-10">
      {theme.heroTitle ? (
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-slate-900 leading-[1.1] tracking-tight mb-6" set:html={theme.heroTitle} />
      ) : (
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-slate-900 leading-[1.1] tracking-tight mb-6">
          Write Code. <br/><span class="text-[#04AA6D]">Build Projects.</span>
        </h1>
      )}
      {theme.heroSubtitle ? (
        <p class="text-slate-600 text-lg sm:text-xl leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0" set:html={theme.heroSubtitle} />
      ) : (
        <p class="text-slate-600 text-lg sm:text-xl leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0">
          The ultimate platform to kickstart your coding journey. Free interactive tutorials for developers of all levels.
        </p>
      )}
      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
        <a href={theme.heroBtnUrl || "/tutorial/html-introduction"} class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-bold text-white bg-slate-900 hover:bg-slate-800 rounded-lg shadow-lg hover:-translate-y-1 transition-all duration-300">
          {theme.heroBtnText || "Start Learning Free"}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a href={theme.heroSecondaryBtnUrl || "#courses"} class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-semibold text-slate-700 bg-white border-2 border-slate-200 hover:border-slate-300 rounded-lg hover:-translate-y-1 transition-all duration-300 shadow-sm">
          {theme.heroSecondaryBtnText || "Browse All Courses"}
        </a>
      </div>
      <div class="mt-8 flex items-center justify-center lg:justify-start gap-4">
        <div class="flex -space-x-2">
          <div class="w-8 h-8 rounded-full bg-blue-100 border-2 border-white flex items-center justify-center text-xs">💻</div>
          <div class="w-8 h-8 rounded-full bg-green-100 border-2 border-white flex items-center justify-center text-xs">🚀</div>
          <div class="w-8 h-8 rounded-full bg-purple-100 border-2 border-white flex items-center justify-center text-xs">✨</div>
        </div>
        <div class="text-sm text-slate-500 font-medium">Join 50,000+ developers</div>
      </div>
    </div>
    <div class="flex-1 relative w-full max-w-2xl lg:max-w-none">
      <div class="absolute inset-0 bg-gradient-to-tr from-[#04AA6D]/20 to-blue-400/20 rounded-[3rem] blur-3xl transform rotate-3"></div>
      <div class="relative bg-white border border-slate-200 shadow-2xl rounded-2xl overflow-hidden transform -rotate-1 hover:rotate-0 transition-transform duration-500">
        <div class="bg-slate-100 px-4 py-3 flex items-center gap-2 border-b border-slate-200">
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <div class="w-3 h-3 rounded-full bg-amber-400"></div>
          <div class="w-3 h-3 rounded-full bg-green-400"></div>
          <div class="flex-1 flex justify-center"><div class="bg-white px-4 py-1 rounded text-xs text-slate-500 shadow-sm border border-slate-200">editor.js</div></div>
        </div>
        <div class="p-6 font-mono text-sm leading-loose bg-[#0f172a] text-slate-300">
          <div class="flex"><span class="w-8 text-slate-600 select-none">1</span><span class="text-purple-400">function</span>&nbsp;<span class="text-blue-400">learnToCode</span>() &#123;</div>
          <div class="flex"><span class="w-8 text-slate-600 select-none">2</span>&nbsp;&nbsp;<span class="text-purple-400">const</span> skills =&nbsp;<span class="text-amber-300">['HTML', 'CSS', 'JS']</span>;</div>
          <div class="flex"><span class="w-8 text-slate-600 select-none">3</span>&nbsp;&nbsp;<span class="text-purple-400">return</span> skills.<span class="text-blue-300">map</span>(skill =&gt; &#123;</div>
          <div class="flex"><span class="w-8 text-slate-600 select-none">4</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-purple-400">return</span> <span class="text-green-300">\`Mastering {"$"}{"{"}skill{"}"}\`</span>;</div>
          <div class="flex"><span class="w-8 text-slate-600 select-none">5</span>&nbsp;&nbsp;&#125;);</div>
          <div class="flex"><span class="w-8 text-slate-600 select-none">6</span>&#125;</div>
          <div class="flex"><span class="w-8 text-slate-600 select-none">7</span></div>
          <div class="flex"><span class="w-8 text-slate-600 select-none">8</span>console.<span class="text-blue-300">log</span>(<span class="text-blue-400">learnToCode</span>());</div>
          <div class="mt-4 pt-4 border-t border-slate-700/50 text-slate-400">&gt; ["Mastering HTML", "Mastering CSS", "Mastering JS"]</div>
        </div>
      </div>
    </div>
  </div>
</section>

{theme.showFeaturedSection !== false && (
<section class="w-full bg-white py-24 px-5">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-20">
      <h2 class="text-4xl lg:text-5xl font-black text-slate-900" set:html={theme.featuresTitle || 'Why Learn With Us?'} />
      <p class="text-slate-500 text-lg mt-4 max-w-2xl mx-auto" set:html={theme.featuresSubtitle || 'Everything you need to master web development.'} />
    </div>
    <div class="space-y-24">
      <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-24">
        <div class="flex-1 relative">
          <div class="absolute inset-0 bg-blue-100 rounded-3xl transform -rotate-3 scale-105"></div>
          <div class="relative bg-white border border-slate-200 rounded-3xl p-8 shadow-xl">
            <div class="w-16 h-16 bg-blue-500 text-white rounded-2xl flex items-center justify-center text-3xl mb-6 shadow-lg shadow-blue-500/30">⚡</div>
            <h3 class="text-2xl font-bold text-slate-900 mb-4">Instant Live Feedback</h3>
            <p class="text-slate-600 leading-relaxed text-lg">Stop waiting for compilers. Our built-in editor runs your HTML, CSS, and JS directly in the browser so you can see your mistakes and fix them instantly.</p>
          </div>
        </div>
        <div class="flex-1">
          <h3 class="text-3xl font-bold text-slate-900 mb-4">Code While You Read</h3>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">Theory is great, but practice is better. Every single chapter across all our courses is paired with an interactive playground.</p>
          <ul class="space-y-3">
            <li class="flex items-center gap-3 text-slate-700"><span class="text-[#04AA6D] font-bold">✓</span> No installation required</li>
            <li class="flex items-center gap-3 text-slate-700"><span class="text-[#04AA6D] font-bold">✓</span> Cloud-based environments</li>
            <li class="flex items-center gap-3 text-slate-700"><span class="text-[#04AA6D] font-bold">✓</span> Mobile-friendly editor</li>
          </ul>
        </div>
      </div>
      
      <div class="flex flex-col md:flex-row-reverse items-center gap-12 lg:gap-24">
        <div class="flex-1 relative">
          <div class="absolute inset-0 bg-orange-100 rounded-3xl transform rotate-3 scale-105"></div>
          <div class="relative bg-white border border-slate-200 rounded-3xl p-8 shadow-xl">
            <div class="w-16 h-16 bg-orange-500 text-white rounded-2xl flex items-center justify-center text-3xl mb-6 shadow-lg shadow-orange-500/30">🗺️</div>
            <h3 class="text-2xl font-bold text-slate-900 mb-4">Clear Learning Paths</h3>
            <p class="text-slate-600 leading-relaxed text-lg">Never wonder "what should I learn next?". We've structured the entire front-end ecosystem into an easy-to-follow, step-by-step roadmap.</p>
          </div>
        </div>
        <div class="flex-1">
          <h3 class="text-3xl font-bold text-slate-900 mb-4">Guided Progression</h3>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">We eliminate tutorial hell by giving you exactly what you need to know, exactly when you need to know it.</p>
          <ul class="space-y-3">
            <li class="flex items-center gap-3 text-slate-700"><span class="text-orange-500 font-bold">✓</span> Bite-sized lessons</li>
            <li class="flex items-center gap-3 text-slate-700"><span class="text-orange-500 font-bold">✓</span> Logical concept stacking</li>
            <li class="flex items-center gap-3 text-slate-700"><span class="text-orange-500 font-bold">✓</span> Zero fluff content</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
)}

{theme.showTutorialCategories !== false && (
<section class="w-full bg-slate-900 py-24 px-5 text-white">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col sm:flex-row items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl">
        <h2 class="text-4xl font-black text-white" set:html={theme.coursesTitle || 'Popular Learning Paths'} />
        <p class="text-slate-400 text-lg mt-4" set:html={theme.coursesSubtitle || 'Choose a path to start coding immediately.'} />
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <a href="/tutorial/html-introduction" class="group block relative p-8 rounded-3xl bg-slate-800 border border-slate-700 hover:border-orange-500 hover:bg-slate-800/80 transition-all">
        <div class="w-16 h-16 rounded-full bg-orange-500/20 text-orange-400 flex items-center justify-center text-2xl font-black mb-8 group-hover:scale-110 transition-transform">&lt;/&gt;</div>
        <h3 class="text-2xl font-bold mb-3 group-hover:text-orange-400 transition-colors">HTML</h3>
        <p class="text-slate-400 mb-8 line-clamp-3">The skeleton of every webpage. Learn to structure content, create forms, add images, and build solid foundations.</p>
        <div class="font-bold text-orange-400 flex items-center gap-2">Start Course <span class="group-hover:translate-x-2 transition-transform">→</span></div>
      </a>
      <a href="/tutorial/css-introduction" class="group block relative p-8 rounded-3xl bg-slate-800 border border-slate-700 hover:border-blue-500 hover:bg-slate-800/80 transition-all">
        <div class="w-16 h-16 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center text-2xl font-black mb-8 group-hover:scale-110 transition-transform">{ }</div>
        <h3 class="text-2xl font-bold mb-3 group-hover:text-blue-400 transition-colors">CSS</h3>
        <p class="text-slate-400 mb-8 line-clamp-3">Make your HTML beautiful. Master colors, layouts, Flexbox, Grid, animations, and fully responsive designs.</p>
        <div class="font-bold text-blue-400 flex items-center gap-2">Start Course <span class="group-hover:translate-x-2 transition-transform">→</span></div>
      </a>
      <a href="/tutorial/js-introduction" class="group block relative p-8 rounded-3xl bg-slate-800 border border-slate-700 hover:border-yellow-500 hover:bg-slate-800/80 transition-all">
        <div class="w-16 h-16 rounded-full bg-yellow-500/20 text-yellow-400 flex items-center justify-center text-2xl font-black mb-8 group-hover:scale-110 transition-transform">JS</div>
        <h3 class="text-2xl font-bold mb-3 group-hover:text-yellow-400 transition-colors">JavaScript</h3>
        <p class="text-slate-400 mb-8 line-clamp-3">Bring pages to life. Handle clicks, fetch APIs, build dynamic interfaces, and write real programs.</p>
        <div class="font-bold text-yellow-400 flex items-center gap-2">Start Course <span class="group-hover:translate-x-2 transition-transform">→</span></div>
      </a>
    </div>
  </div>
</section>
)}

{(theme.showRecentPosts !== false && latestPosts.length > 0) && (
<section class="w-full bg-slate-50 py-24 px-5">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-black text-slate-900" set:html={theme.postsTitle || 'Latest from the Blog'} />
      <p class="text-slate-500 mt-2" set:html={theme.postsSubtitle || 'Read our newest tips, tricks, and tutorials.'} />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {latestPosts.map(post => {
        const catColor = CATEGORY_COLORS[post.data.category] ?? { color: '#6b7280', bg: '#f3f4f6' };
        return (
          <a href={`/blog/${post.slug}`} class="group bg-white rounded-2xl overflow-hidden shadow-lg shadow-slate-200/50 hover:-translate-y-2 transition-all duration-300 block no-underline border border-slate-100">
            {post.data.image ? (
              <div class="h-48 overflow-hidden"><img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" /></div>
            ) : (
              <div class="h-48 bg-slate-100 flex items-center justify-center text-4xl">💻</div>
            )}
            <div class="p-6">
              <span class="text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-4 inline-block" style={`color:${catColor.color};background:${catColor.bg}`}>{post.data.category}</span>
              <h3 class="text-xl font-bold text-slate-900 leading-snug mb-3 group-hover:text-[#04AA6D] transition-colors line-clamp-2">{post.data.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed line-clamp-2">{post.data.description}</p>
            </div>
          </a>
        );
      })}
    </div>
    <div class="text-center mt-12">
      <a href="/blog" class="inline-flex items-center justify-center px-8 py-4 bg-slate-200 text-slate-700 font-bold rounded-xl hover:bg-slate-300 transition-colors">Browse all articles</a>
    </div>
  </div>
</section>
)}
