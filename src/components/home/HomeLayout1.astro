---
import { getCollection } from 'astro:content';
import themeRaw from '../../theme-settings.json';

const theme = themeRaw || {};
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const CATEGORY_COLORS: Record<string, { color: string; bg: string }> = {
  'HTML & CSS':           { color: '#E34F26', bg: '#fff4f0' },
  'JavaScript':           { color: '#ca8a04', bg: '#fefce8' },
  'HTML CSS JavaScript':  { color: '#04AA6D', bg: '#f0fff8' },
};
---

<section class="relative w-full overflow-hidden bg-[#282A35]">
  <div class="absolute inset-0 bg-[linear-gradient(rgba(4,170,109,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(4,170,109,0.05)_1px,transparent_1px)] bg-[size:3rem_3rem]"></div>
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-[#04AA6D]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>
  <div aria-hidden="true" class="hidden lg:block absolute top-12 left-6 font-mono text-xs text-[#04AA6D]/40 leading-relaxed select-none float-1">
    &lt;<span class="text-orange-400/50">html</span>&gt;<br/>
    &nbsp;&lt;<span class="text-orange-400/50">head</span>&gt;&lt;/<span class="text-orange-400/50">head</span>&gt;<br/>
    &nbsp;&lt;<span class="text-orange-400/50">body</span>&gt;<br/>
    &nbsp;&nbsp;&lt;<span class="text-orange-400/50">h1</span>&gt;Hello!&lt;/<span class="text-orange-400/50">h1</span>&gt;<br/>
    &nbsp;&lt;/<span class="text-orange-400/50">body</span>&gt;<br/>
    &lt;/<span class="text-orange-400/50">html</span>&gt;
  </div>
  <div aria-hidden="true" class="hidden lg:block absolute top-16 right-6 font-mono text-xs text-blue-400/40 leading-relaxed select-none text-right float-2">
    <span class="text-purple-400/50">.hero</span> &#123;<br/>
    &nbsp;&nbsp;<span class="text-blue-300/50">display</span>: flex;<br/>
    &nbsp;&nbsp;<span class="text-blue-300/50">color</span>: <span class="text-green-400/50">#04AA6D</span>;<br/>
    &nbsp;&nbsp;<span class="text-blue-300/50">gap</span>: 1rem;<br/>
    &#125;
  </div>
  <div aria-hidden="true" class="hidden xl:block absolute bottom-20 left-12 font-mono text-xs text-yellow-400/30 leading-relaxed select-none float-3">
    <span class="text-yellow-300/40">const</span> <span class="text-white/30">learn</span> = () =&gt; &#123;<br/>
    &nbsp;&nbsp;<span class="text-yellow-300/40">return</span> <span class="text-green-400/40">'success'</span>;<br/>
    &#125;;
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-5 py-24 sm:py-32 text-center">
    <div class="inline-flex items-center gap-2 bg-[#04AA6D]/10 border border-[#04AA6D]/30 rounded-full px-4 py-2 mb-8"><span class="w-2 h-2 rounded-full bg-[#04AA6D] animate-pulse"></span><span class="text-[#04AA6D] text-sm font-semibold">Free · No Sign-up · Start Instantly</span></div>
    {theme.heroTitle ? (<h1 class="text-5xl sm:text-6xl md:text-7xl font-black text-white leading-none tracking-tight mb-6" set:html={theme.heroTitle} />) : (<h1 class="text-5xl sm:text-6xl md:text-7xl font-black text-white leading-none tracking-tight mb-6">Learn HTML, CSS &amp;<br/><span class="relative inline-block mt-2"><span class="relative z-10 text-transparent bg-clip-text bg-gradient-to-r from-[#04AA6D] to-emerald-300">JavaScript Online</span><span class="absolute -bottom-2 left-0 right-0 h-1 bg-gradient-to-r from-[#04AA6D] to-emerald-300 rounded-full opacity-50"></span></span><span class="block text-2xl sm:text-3xl text-gray-300 font-medium mt-4">Free &amp; Interactive</span></h1>)}
    {theme.heroSubtitle ? (<p class="text-gray-400 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed mb-10" set:html={theme.heroSubtitle} />) : (<p class="text-gray-400 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed mb-10">Interactive, hands-on tutorials for <strong class="text-orange-400">HTML</strong>, <strong class="text-blue-400">CSS</strong>, and <strong class="text-yellow-400">JavaScript</strong>. Write real code in the browser and see results instantly — no setup, no downloads.</p>)}
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a href={theme.heroBtnUrl || "/tutorial/html-introduction/"} class="group w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-bold text-white bg-[#04AA6D] hover:bg-[#038a58] rounded-lg shadow-lg shadow-[#04AA6D]/20 hover:shadow-[#04AA6D]/40 hover:-translate-y-0.5 transition-all duration-200">{theme.heroBtnText || "Start Learning Free"}<svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg></a>
      <a href={theme.heroSecondaryBtnUrl || "#courses"} class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-semibold text-gray-300 border border-gray-600 hover:border-gray-400 hover:text-white rounded-lg transition-all duration-200">{theme.heroSecondaryBtnText || "Browse All Courses"}</a>
    </div>
    <div class="max-w-2xl mx-auto bg-[#1a1b26] rounded-2xl border border-white/10 shadow-2xl overflow-hidden text-left">
      <div class="flex items-center gap-2 px-4 py-3 bg-[#13131e] border-b border-white/10"><span class="w-2.5 h-2.5 rounded-full bg-red-500/70"></span><span class="w-2.5 h-2.5 rounded-full bg-yellow-400/70"></span><span class="w-2.5 h-2.5 rounded-full bg-green-500/70"></span><div class="flex-1 flex justify-center"><span class="text-gray-500 text-xs font-mono">index.html — CodesCompiler Try It Yourself</span></div></div>
      <div class="p-5 font-mono text-sm leading-relaxed"><div><span class="text-gray-500">1 </span><span class="text-orange-400">&lt;h1</span> <span class="text-yellow-300">style</span><span class="text-white">=</span><span class="text-green-400">"color:#04AA6D"</span><span class="text-orange-400">&gt;</span><span class="text-white">Hello, World!</span><span class="text-orange-400">&lt;/h1&gt;</span></div><div><span class="text-gray-500">2 </span><span class="text-orange-400">&lt;p&gt;</span><span class="text-white">I am learning <span class="text-blue-300">HTML</span> at CodesCompiler.</span><span class="text-orange-400">&lt;/p&gt;</span></div><div><span class="text-gray-500">3 </span><span class="text-orange-400">&lt;button</span> <span class="text-yellow-300">onclick</span><span class="text-white">=</span><span class="text-green-400">"alert('It works! 🎉')"</span><span class="text-orange-400">&gt;</span><span class="text-white">Click Me</span><span class="text-orange-400">&lt;/button&gt;</span></div><div class="mt-2 pt-2 border-t border-white/5 text-gray-500 text-xs">▶ Output: <span class="text-white font-sans">Hello, World!</span> &nbsp; <span class="text-[#04AA6D]">I am learning HTML at CodesCompiler.</span> &nbsp; <span class="bg-gray-700 text-white px-2 py-0.5 rounded text-xs">Click Me</span></div></div>
    </div>
  </div>
</section>

<section class="w-full border-y border-emerald-700/20 bg-gradient-to-r from-emerald-600 via-[#04AA6D] to-emerald-600 text-white" aria-label="CodesCompiler highlights"><div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 sm:py-4"><div class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-3">{[{ v: '50+', l: 'Tutorial Chapters', icon: 'book' },{ v: '200+', l: 'Code Examples', icon: 'code' },{ v: '3', l: 'Learning Paths', icon: 'route' },{ v: '$0', l: 'Always Free', icon: 'spark' }].map(s => (<div class="stats-card group flex items-center sm:justify-center gap-3 sm:gap-4 min-h-[68px] sm:min-h-[76px] rounded-xl px-3 sm:px-5 py-2.5 sm:py-3 transition-all duration-200 hover:bg-white/10"><span class="stats-icon flex h-10 w-10 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-lg bg-white/10 ring-1 ring-white/15 text-white" aria-hidden="true">{s.icon === 'book' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5 sm:h-[22px] sm:w-[22px]"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5v-15Z"/><path stroke-linecap="round" d="M4 20.5A2.5 2.5 0 0 1 6.5 18H20M8 7h8M8 11h6"/></svg>}{s.icon === 'code' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5 sm:h-[22px] sm:w-[22px]"><path stroke-linecap="round" stroke-linejoin="round" d="m8.5 8-4 4 4 4M15.5 8l4 4-4 4M13.5 5l-3 14"/></svg>}{s.icon === 'route' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5 sm:h-[22px] sm:w-[22px]"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M8.5 6c4 0 1.5 8 6 8h1M18 15.5c0-3.5-2-5.5-5-5.5H12"/></svg>}{s.icon === 'spark' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5 sm:h-[22px] sm:w-[22px]"><path stroke-linecap="round" stroke-linejoin="round" d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3ZM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z"/></svg>}</span><span class="min-w-0 text-left sm:text-center"><span class="block text-[1.45rem] sm:text-3xl font-extrabold tracking-tight leading-none">{s.v}</span><span class="mt-1 block text-[11px] sm:text-sm font-medium text-emerald-50/95 leading-tight truncate sm:whitespace-normal">{s.l}</span></span></div>))}</div></div></section>

{theme.showTutorialCategories !== false && (<section id="courses" class="relative w-full overflow-hidden bg-slate-50 py-20 sm:py-24 px-4 sm:px-6"><div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_15%_15%,rgba(59,130,246,0.08),transparent_28%),radial-gradient(circle_at_85%_25%,rgba(168,85,247,0.08),transparent_28%),radial-gradient(circle_at_70%_85%,rgba(16,185,129,0.07),transparent_30%)]"></div><div class="relative max-w-7xl mx-auto"><div class="max-w-3xl mx-auto text-center mb-12 sm:mb-14"><span class="inline-flex items-center rounded-full bg-blue-50 px-4 py-2 text-xs sm:text-sm font-bold tracking-[0.18em] text-blue-600 uppercase">Learn by Topics</span><h2 class="mt-5 text-4xl sm:text-5xl font-black tracking-tight text-slate-950" set:html={theme.coursesTitle || 'Explore Our <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-violet-600">Tutorial Library</span>'} /><p class="mt-4 text-base sm:text-lg leading-7 text-slate-500" set:html={theme.coursesSubtitle || 'Step-by-step guides, real examples, and practical projects to help you learn web development and programming skills for free.'} /></div><div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-6 gap-5 sm:gap-6">
  
  <a href="/tutorial/html-introduction/" class="course-card group xl:col-span-2 relative overflow-hidden rounded-[24px] border border-orange-100 bg-gradient-to-br from-white via-orange-50/60 to-orange-100/60 p-6 sm:p-7 shadow-[0_12px_35px_rgba(15,23,42,0.06)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_45px_rgba(249,115,22,0.14)]"><div class="absolute -right-8 -top-10 h-36 w-36 rounded-full bg-orange-200/40 blur-2xl"></div><div class="absolute right-5 top-5 text-orange-300/40" aria-hidden="true"><svg viewBox="0 0 64 64" class="h-20 w-20"><path fill="currentColor" d="M12 4h40l-4 48-16 8-16-8L12 4Z"/><path fill="#fff" d="M21 14h22l-.7 7H28l.5 6h13.7l-1.3 14-9.1 4-9-4-.6-7h7l.3 3 2.4 1 2.5-1 .4-4H21l-1.8-19Z"/></svg></div><div class="relative min-h-[330px] sm:min-h-[355px] flex flex-col"><span class="self-start rounded-full bg-orange-100 px-3.5 py-2 text-xs font-bold text-orange-700">Beginner</span><div class="mt-6 pr-20"><h3 class="text-3xl font-black text-slate-950">HTML</h3><p class="mt-3 text-sm sm:text-[15px] leading-6 text-slate-600">The skeleton of every webpage. Learn to structure content, create forms, add images, and build solid foundations.</p></div><div class="mt-auto"><div class="flex flex-wrap items-center gap-4 text-sm text-slate-500"><span>📚 12 chapters</span><span>◷ ~3 hours</span></div><div class="mt-5 inline-flex w-full items-center justify-center gap-3 rounded-full bg-orange-500 px-5 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-orange-500/20 transition group-hover:bg-orange-600">Start HTML <span class="text-lg transition-transform group-hover:translate-x-1">→</span></div></div></div></a>
  <a href="/tutorial/css-introduction/" class="course-card group xl:col-span-2 relative overflow-hidden rounded-[24px] border border-blue-100 bg-gradient-to-br from-white via-blue-50/60 to-sky-100/60 p-6 sm:p-7 shadow-[0_12px_35px_rgba(15,23,42,0.06)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_45px_rgba(37,99,235,0.14)]"><div class="absolute -right-8 -top-10 h-36 w-36 rounded-full bg-blue-200/50 blur-2xl"></div><div class="absolute right-5 top-5 text-blue-200" aria-hidden="true"><svg viewBox="0 0 64 64" class="h-20 w-20"><path fill="currentColor" d="m10 5 44 0-4 49-18 7-18-7L10 5Z"/><path fill="#fff" d="M20 16h24v6H27l.5 6H43l-1.5 17L32 49l-9-4-.5-8h7l.2 3 2.1 1 2.4-1 .5-6H20l-2-18h4Z"/></svg></div><div class="relative min-h-[330px] sm:min-h-[355px] flex flex-col"><span class="self-start rounded-full bg-blue-100 px-3.5 py-2 text-xs font-bold text-blue-700">Step 2</span><div class="mt-6 pr-20"><h3 class="text-3xl font-black text-slate-950">CSS</h3><p class="mt-3 text-sm sm:text-[15px] leading-6 text-slate-600">Make your HTML beautiful. Master colors, layouts, Flexbox, Grid, animations, and fully responsive designs.</p></div><div class="mt-auto"><div class="flex flex-wrap items-center gap-4 text-sm text-slate-500"><span>📚 15 chapters</span><span>◷ ~4 hours</span></div><div class="mt-5 inline-flex w-full items-center justify-center gap-3 rounded-full bg-blue-600 px-5 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-blue-600/20 transition group-hover:bg-blue-700">Start CSS <span class="text-lg transition-transform group-hover:translate-x-1">→</span></div></div></div></a>
  <a href="/tutorial/javascript-introduction/" class="course-card group xl:col-span-2 relative overflow-hidden rounded-[24px] border border-yellow-100 bg-gradient-to-br from-white via-yellow-50/70 to-amber-100/60 p-6 sm:p-7 shadow-[0_12px_35px_rgba(15,23,42,0.06)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_45px_rgba(234,179,8,0.14)]"><div class="absolute -right-8 -top-10 h-36 w-36 rounded-full bg-yellow-200/50 blur-2xl"></div><div class="absolute right-5 top-5 text-yellow-300/70" aria-hidden="true"><svg viewBox="0 0 64 64" class="h-20 w-20"><rect x="7" y="7" width="50" height="50" rx="7" fill="currentColor"/><text x="32" y="42" text-anchor="middle" font-size="24" font-weight="900" fill="#111827">JS</text></svg></div><div class="relative min-h-[330px] sm:min-h-[355px] flex flex-col"><span class="self-start rounded-full bg-yellow-100 px-3.5 py-2 text-xs font-bold text-yellow-700">Step 3</span><div class="mt-6 pr-20"><h3 class="text-3xl font-black text-slate-950">JavaScript</h3><p class="mt-3 text-sm sm:text-[15px] leading-6 text-slate-600">Bring pages to life. Handle clicks, fetch APIs, build dynamic interfaces, and write real programs.</p></div><div class="mt-auto"><div class="flex flex-wrap items-center gap-4 text-sm text-slate-500"><span>📚 18 chapters</span><span>◷ ~6 hours</span></div><div class="mt-5 inline-flex w-full items-center justify-center gap-3 rounded-full bg-yellow-400 px-5 py-3.5 text-sm font-extrabold text-slate-900 shadow-lg shadow-yellow-400/20 transition group-hover:bg-yellow-500">Start JavaScript <span class="text-lg transition-transform group-hover:translate-x-1">→</span></div></div></div></a>
  <a href="/tutorial/python-introduction/" class="course-card group xl:col-span-3 relative overflow-hidden rounded-[24px] border border-sky-100 bg-gradient-to-br from-white via-sky-50/70 to-blue-100/70 p-6 sm:p-7 shadow-[0_12px_35px_rgba(15,23,42,0.06)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_45px_rgba(14,165,233,0.14)]"><div class="absolute -right-8 -top-10 h-40 w-40 rounded-full bg-sky-200/50 blur-2xl"></div><div class="absolute right-5 top-5 text-sky-200" aria-hidden="true"><svg viewBox="0 0 90 70" class="h-20 w-24"><circle cx="34" cy="24" r="18" fill="#3776ab"/><circle cx="58" cy="46" r="18" fill="#ffd343"/><path fill="#fff" d="M24 18h12v8H27v8h16v-8h-8v-8h9a13 13 0 0 1 13 13v5H43v8h-7A12 12 0 0 1 24 32V18Zm31 25H43v8h-8a13 13 0 0 0-13 13v5h18v-8h-6v-8h12v8h9a13 13 0 0 0 13-13V43Z"/></svg></div><div class="relative min-h-[300px] sm:min-h-[320px] flex flex-col"><span class="self-start rounded-full bg-sky-100 px-3.5 py-2 text-xs font-bold text-sky-700">Backend</span><div class="mt-6 pr-24"><h3 class="text-3xl font-black text-slate-950">Python</h3><p class="mt-3 text-sm sm:text-[15px] leading-6 text-slate-600">Master Python programming syntax, data structures, algorithms, object-oriented concepts, and automation.</p></div><div class="mt-auto"><div class="flex flex-wrap items-center gap-4 text-sm text-slate-500"><span>📚 20 chapters</span><span>◷ ~7 hours</span></div><div class="mt-5 inline-flex w-full items-center justify-center gap-3 rounded-full bg-sky-500 px-5 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-sky-500/20 transition group-hover:bg-sky-600">Start Python <span class="text-lg transition-transform group-hover:translate-x-1">→</span></div></div></div></a>
